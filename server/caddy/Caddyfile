(capy_routes) {
  handle /api/* {
    request_body {
      max_size 64KB
    }
    reverse_proxy 127.0.0.1:8770
  }
  handle /privacy* {
    root * /srv/site
    rewrite * /privacy/index.html
    header Cache-Control "public, max-age=300"
    file_server
  }
}

2-29-147-164.sslip.io {
  handle /orrelay/* {
    request_body {
      max_size 30MB
    }
    reverse_proxy 127.0.0.1:8795 {
      transport http {
        read_timeout 300s
      }
    }
  }
  handle /media/* {
    root * /srv
    file_server
  }
  import capy_routes
  handle {
    reverse_proxy 127.0.0.1:8765
  }
}

playcapybarasquad.com, www.playcapybarasquad.com {
  encode zstd gzip
  log {
    output file /var/log/caddy/com_access.log {
      roll_size 20MiB
      roll_keep 3
      roll_keep_for 72h
    }
    format json
  }
  import capy_routes
  @html path / /index.html /sw.js /offline.json /manifest.webmanifest
  header @html Cache-Control "no-cache"
  @mf path /manifest.webmanifest
  header @mf Content-Type "application/manifest+json"
  @aab path *.aab
  header @aab Content-Type "application/octet-stream"
  header @aab Content-Disposition "attachment; filename=\"capybara-squad-1.0.1.aab\""
  handle {
    root * /srv/site/www
    file_server
  }
}
